# Base de données PostgreSQL (Docker compose dev : port 5433, conteneur rr-cesi-db)
DATABASE_URL="postgresql://test:test@127.0.0.1:5433/rr_cesi"

# Secret HMAC-SHA256 utilisé pour signer les tokens JWT.
# OBLIGATOIRE en production — l'application refuse de démarrer si absent.
# Générer avec : openssl rand -base64 64
AUTH_TOKEN_SECRET="changez-moi-en-production"

# Durée de validité d'un token (millisecondes). Défaut 1h = 3600000.
AUTH_TOKEN_EXPIRATION=3600000

# Port d'écoute
PORT=3001

# Origines CORS autorisées (CSV). Défaut : localhost:3000 et localhost:3001.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate limiting global — fenêtre en ms et nombre max de requêtes par IP
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Rate limiting renforcé sur /auth/* (login, register) — limite par IP sur la même fenêtre
THROTTLE_AUTH_LIMIT=5

# Documentation Swagger sur /api — désactiver en production si non souhaité
SWAGGER_ENABLED=true
