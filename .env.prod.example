# =============================================================================
# Variables d'environnement — PRODUCTION
#
# Copier ce fichier en `.env.prod` (ignoré par git) et adapter les valeurs.
# Démarrage :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Note : en production, les secrets devraient idéalement être servis par un
# coffre-fort (HashiCorp Vault, AWS Secrets Manager, Docker Secrets) plutôt
# qu'un fichier .env. La présente configuration est le minimum acceptable.
# =============================================================================

# --- Application ---------------------------------------------------------------

NODE_ENV=production
PORT=3001

# Swagger : désactivé en production (pas d'exposition de la surface API)
SWAGGER_ENABLED=false

# --- Authentification ----------------------------------------------------------

# OBLIGATOIRE — secret HMAC-SHA256 fort (>= 64 caractères)
# Générer : openssl rand -base64 64
# À ROULER au minimum une fois par mois (cf. docs/SECURITY.md).
AUTH_TOKEN_SECRET="changez-moi-en-prod-via-openssl-rand"

# Durée de validité d'un token, en millisecondes (1 h = 3600000)
AUTH_TOKEN_EXPIRATION=3600000

# --- CORS ----------------------------------------------------------------------

# Origines autorisées (CSV) — domaine prod uniquement
CORS_ORIGIN=https://ressources-relationnelles.example

# --- Rate limiting -------------------------------------------------------------

THROTTLE_TTL=60000
THROTTLE_LIMIT=10
THROTTLE_AUTH_LIMIT=5

# --- Base de données PostgreSQL ------------------------------------------------
#
# Ces variables sont consommées par le conteneur `db` ET réutilisées dans
# `DATABASE_URL` construite côté `api` au démarrage du compose.

POSTGRES_USER=rr_prod
POSTGRES_PASSWORD=changez-moi-fort
POSTGRES_DB=rr_prod
