# =============================================================================
# Variables d'environnement — PRÉ-PRODUCTION
#
# Copier ce fichier en `.env.preprod` (ignoré par git) et adapter les valeurs.
# Démarrage :
#   docker compose -f docker-compose.preprod.yml --env-file .env.preprod up -d
# =============================================================================

# --- Application ---------------------------------------------------------------

NODE_ENV=preproduction
PORT=3001

# Swagger : laisser activé en preprod pour faciliter la validation manuelle
SWAGGER_ENABLED=true

# --- Authentification ----------------------------------------------------------

# OBLIGATOIRE — secret HMAC-SHA256 fort (>= 64 caractères)
# Générer : openssl rand -base64 64
AUTH_TOKEN_SECRET="changez-moi-en-preprod-via-openssl-rand"

# Durée de validité d'un token, en millisecondes (1 h = 3600000)
AUTH_TOKEN_EXPIRATION=3600000

# --- CORS ----------------------------------------------------------------------

# Origines autorisées (CSV) — pointer vers le domaine frontend preprod
CORS_ORIGIN=https://preprod.ressources-relationnelles.example

# --- Rate limiting -------------------------------------------------------------

THROTTLE_TTL=60000
THROTTLE_LIMIT=10
THROTTLE_AUTH_LIMIT=5

# --- Base de données PostgreSQL ------------------------------------------------
#
# Ces variables sont consommées par le conteneur `db` (image postgres:16-alpine)
# ET réutilisées dans `DATABASE_URL` construite côté `api` au démarrage du
# compose. L'hôte est `db` (nom du service Compose, pas localhost).

POSTGRES_USER=rr_preprod
POSTGRES_PASSWORD=changez-moi-fort
POSTGRES_DB=rr_preprod
